// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  VIEWER
  CREATOR
  ADMIN
}

enum StreamStatus {
  OFFLINE
  LIVE
  ENDED
}

enum ReportStatus {
  OPEN
  RESOLVED
  DISMISSED
}

enum TransactionType {
  PURCHASE
  TIP
  REFUND
  EARNINGS
}

enum ReportReason {
  SPAM
  HARASSMENT
  INAPPROPRIATE_CONTENT
  COPYRIGHT
  OTHER
}

model User {
  id        String   @id @default(cuid())
  username  String   @unique
  email     String   @unique
  password  String?
  avatar    String?
  role      UserRole @default(VIEWER)
  suspended Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  creatorProfile      CreatorProfile?
  streams             Stream[]
  chatMessages        ChatMessage[]
  follows             Follow[]            @relation("follower")
  followedBy          Follow[]            @relation("following")
  favourites          Favourite[]
  createdFavourites   Favourite[]         @relation("CreatorFavourites")
  creditBalance       CreditBalance?
  transactions        CreditTransaction[]
  relatedTransactions CreditTransaction[] @relation("CreditTransactionRelatedUser")
  sentTransfers       CreditTransfer[]    @relation("CreditTransferSender")
  receivedTransfers   CreditTransfer[]    @relation("CreditTransferCreator")
  reports             Report[]            @relation("reporter")
  reportedBy          Report[]            @relation("reportedUser")

  @@index([username])
  @@index([email])
}

model CreatorProfile {
  id          String   @id @default(cuid())
  userId      String   @unique
  displayName String?
  bio         String?
  banner      String?
  categories  String[] // Stored as JSON array
  totalViews  Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Stream {
  id          String       @id @default(cuid())
  creatorId   String
  title       String
  description String       @default("")
  category    String
  thumbnail   String?
  status      StreamStatus @default(OFFLINE)
  viewerCount Int          @default(0)
  startedAt   DateTime?
  endedAt     DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  // Relations
  creator      User          @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  chatMessages ChatMessage[]
  reports      Report[]

  @@index([creatorId])
  @@index([status])
  @@index([category])
}

model ChatMessage {
  id        String   @id @default(cuid())
  streamId  String
  userId    String
  message   String
  createdAt DateTime @default(now())

  // Relations
  stream Stream @relation(fields: [streamId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([streamId])
  @@index([userId])
  @@index([createdAt])
}

model Follow {
  id          String   @id @default(cuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  // Relations
  follower  User @relation("follower", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("following", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
}

model Favourite {
  id        String   @id @default(cuid())
  userId    String
  creatorId String
  createdAt DateTime @default(now())

  // Relations
  user    User @relation(fields: [userId], references: [id], onDelete: Cascade)
  creator User @relation("CreatorFavourites", fields: [creatorId], references: [id], onDelete: Cascade)

  @@unique([userId, creatorId])
  @@index([userId])
  @@index([creatorId])
}

model CreditBalance {
  id        String   @id @default(cuid())
  userId    String   @unique
  balance   Int      @default(0)
  updatedAt DateTime @updatedAt

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
}

model CreditTransfer {
  id             String   @id @default(cuid())
  referenceId    String   @unique @default(cuid())
  idempotencyKey String
  senderId       String
  creatorId      String
  amount         Int
  createdAt      DateTime @default(now())

  sender        User                @relation("CreditTransferSender", fields: [senderId], references: [id], onDelete: Restrict)
  creator       User                @relation("CreditTransferCreator", fields: [creatorId], references: [id], onDelete: Restrict)
  ledgerEntries CreditTransaction[]

  @@unique([senderId, idempotencyKey])
  @@index([senderId, createdAt])
  @@index([creatorId, createdAt])
}

model CreditTransaction {
  id            String          @id @default(cuid())
  userId        String
  type          TransactionType
  amount        Int
  description   String          @default("")
  relatedUserId String? // For tips, this is the creator
  transferId    String?
  createdAt     DateTime        @default(now())

  // Relations
  user        User            @relation(fields: [userId], references: [id], onDelete: Restrict)
  relatedUser User?           @relation("CreditTransactionRelatedUser", fields: [relatedUserId], references: [id], onDelete: Restrict)
  transfer    CreditTransfer? @relation(fields: [transferId], references: [id], onDelete: Restrict)

  @@unique([transferId, type])
  @@index([userId])
  @@index([type])
  @@index([createdAt])
  @@index([transferId])
}

model Report {
  id             String       @id @default(cuid())
  reporterId     String
  reportedUserId String?
  streamId       String?
  reason         ReportReason
  description    String
  status         ReportStatus @default(OPEN)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  // Relations
  reporter     User    @relation("reporter", fields: [reporterId], references: [id], onDelete: Cascade)
  reportedUser User?   @relation("reportedUser", fields: [reportedUserId], references: [id], onDelete: SetNull)
  stream       Stream? @relation(fields: [streamId], references: [id], onDelete: SetNull)

  @@index([reporterId])
  @@index([reportedUserId])
  @@index([streamId])
  @@index([status])
}
